+def _absorbed_rhs(B, So, Tb, no_ptr, no_idx, no_cnt):
+    """Plugin addition. A column absorbed by the eliminated fixed effect has a right-hand side
+    B = So - N_ob Tb of rounding residue only (the two terms cancel), which conjugate gradients cannot
+    reduce by tol: it is set to zero, so the column's other coefficients are zero and its demeaned
+    values vanish (the regressor is then dropped as collinear). Residue is judged against the scale
+    of the cancelling terms, |So| + N_ob |Tb|; any column with real variation is far above it."""
+    scale = np.abs(So)
+    _spmm(no_ptr, no_idx, no_cnt, np.abs(Tb), scale, 1.0)
+    noise = ABSORBED * (scale * scale).sum(0)
+    absorbed = (B * B).sum(0) <= noise
+    if absorbed.any():
+        B[:, absorbed] = 0.0
 
 
